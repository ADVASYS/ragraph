{
  "name": "ragraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first knowledge management with an autonomous RAG agent over a hybrid knowledge graph (SQLite + FTS5) and vector database (LanceDB).",
  "license": "MIT",
  "author": {
    "name": "ADVASYS",
    "url": "https://github.com/ADVASYS"
  },
  "homepage": "https://github.com/ADVASYS/ragraph#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ADVASYS/ragraph.git"
  },
  "bugs": {
    "url": "https://github.com/ADVASYS/ragraph/issues"
  },
  "keywords": [
    "rag",
    "knowledge-graph",
    "vector-database",
    "lancedb",
    "sqlite",
    "fts5",
    "electron",
    "local-first",
    "offline",
    "llm",
    "ai-agent",
    "openai-compatible",
    "ollama",
    "embeddings",
    "semantic-search",
    "hybrid-search"
  ],
  "main": "out/main/index.mjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:dir": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:native": "electron-vite preview & vitest run",
    "test:e2e": "playwright test",
    "postinstall": "electron-builder install-app-deps"
  },
